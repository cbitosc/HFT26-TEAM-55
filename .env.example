# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database Configuration (SQLite with FTS5)
DATABASE_URL=sqlite:///./codecompass.db

# Featherless AI API Configuration
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# Explorer agent (must support tool calling)
FEATHERLESS_AGENT_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
MAX_ARCHIVE_MB=20
MAX_SOURCE_KB=256
MAX_SOURCE_FILES=1000
