# NextGen Code Explorer Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Application Server
HOST=127.0.0.1
PORT=8000
DEBUG=False
ENABLE_LOCAL_PATH=0

# AI Explanation Provider (Featherless)
# Sign up at https://featherless.ai to get an API key.
# Leave blank to run in offline / search-only mode.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Ingestion Limits
MAX_ZIP_SIZE_MB=50
MAX_UNCOMPRESSED_SIZE_MB=200
MAX_FILE_COUNT=5000
MAX_SINGLE_FILE_BYTES=204800
MAX_COMPRESSION_RATIO=100

# Ranking Weights
BM25_K1=1.5
BM25_B=0.75
WEIGHT_SYMBOL=3.0
WEIGHT_PATH=2.0
WEIGHT_DOCSTRING=1.5
WEIGHT_CODE=1.0
RRF_K=60
